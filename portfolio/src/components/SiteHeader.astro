---
const path = Astro.url.pathname;

interface NavItem {
  href: string;
  label: string;
}

const items: NavItem[] = [
  { href: '/', label: 'Overview' },
  { href: '/demos', label: 'Demos' },
  { href: '/retractions', label: 'Retractions' },
  { href: '/method', label: 'Method' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-head">
  <div class="shell bar">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M2 18 L7 18 L7 12 L12 12 L12 7 L17 7 L17 2 L22 2" stroke-linecap="square" />
          <circle cx="7" cy="12" r="1.6" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">fibtransponder</span>
        <span class="brand__sub">Fibonacci-radix streaming state machine</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head {
    border-bottom: var(--rule-w) solid var(--rule);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
    padding-block: 0.6rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    min-width: 0;
  }

  .brand__mark {
    color: var(--brass);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--raise-sm);
    border: var(--rule-w) solid var(--rule);
    background: var(--surface);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.06rem;
    letter-spacing: 0.03em;
  }

  .brand__sub {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    color: var(--ink-mute);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  nav ul {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    display: block;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink-dim);
    font-size: 0.86rem;
    font-weight: 600;
    white-space: nowrap;
    border: var(--rule-w) solid transparent;
  }

  nav a:hover {
    color: var(--ink);
    background: var(--surface-raised);
  }

  /* aria-current carries the state, not colour alone. */
  nav a[aria-current='page'] {
    color: var(--brass-lit);
    border-color: var(--brass-dim);
    background: var(--surface-sunk);
  }

  @media (max-width: 46rem) {
    .bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
    }
    .brand__sub {
      display: none;
    }
    nav ul {
      justify-content: space-between;
    }
    nav a {
      text-align: center;
      padding-inline: 0.5rem;
    }
  }
</style>
