---
import Demo from '../../layouts/Demo.astro';
---

<Demo slug="fsvm-stepper">
  <div class="stage panel" data-stage>
    <p class="stage__loading" data-status>Loading the WebAssembly module…</p>

    <div class="stage__body" data-body hidden>
      <!-- Controls -->
      <div class="controls">
        <div class="controls__row">
          <label class="field field--grow">
            <span class="label">Input text</span>
            <textarea
              data-text
              rows="2"
              spellcheck="false"
              aria-describedby="text-hint">The quick brown fox jumps over the lazy dog.</textarea
            >
            <span id="text-hint" class="field__hint">
              Converted to UTF-8 bytes, MSB first — the same conversion the corpus experiments use.
            </span>
          </label>
        </div>

        <div class="controls__row">
          <fieldset class="seg">
            <legend class="label">Sketch version</legend>
            <div class="seg__group" role="radiogroup" aria-label="Sketch version">
              <button type="button" data-version="1" aria-pressed="true">v1 · Zobrist XOR</button>
              <button type="button" data-version="2" aria-pressed="false">v2 · avalanche</button>
            </div>
          </fieldset>

          <fieldset class="seg">
            <legend class="label">Adjacency width</legend>
            <div class="seg__group" role="radiogroup" aria-label="Adjacency width">
              <button type="button" data-width="1" aria-pressed="true">w=1</button>
              <button type="button" data-width="2" aria-pressed="false">w=2</button>
              <button type="button" data-width="3" aria-pressed="false">w=3</button>
            </div>
          </fieldset>

          <label class="field field--narrow">
            <span class="label">Bits</span>
            <input type="number" data-maxbits min="16" max="16384" step="16" value="1024" />
          </label>
        </div>

        <div class="controls__row controls__row--play">
          <button type="button" data-play class="btn btn--primary">▶ Play</button>
          <button type="button" data-step="1">Step ›</button>
          <button type="button" data-reset>↺ Reset</button>

          <label class="scrub">
            <span class="label">Position</span>
            <input type="range" data-scrub min="0" max="0" value="0" step="1" />
          </label>

          <label class="field field--narrow">
            <span class="label">Bits/sec</span>
            <input type="number" data-speed min="1" max="20000" step="1" value="220" />
          </label>
        </div>
      </div>

      <!-- The ribbon -->
      <figure class="ribbon">
        <figcaption class="label">
          Bit ribbon — the machine's view, one column per bit
        </figcaption>
        <div class="ribbon__scroll" tabindex="0" role="region" aria-label="Bit ribbon, scrollable">
          <canvas data-canvas role="img" aria-label="Bit ribbon" aria-describedby="ribbon-alt"></canvas>
        </div>
        <p id="ribbon-alt" class="visually-hidden" data-alt></p>
        <div class="legend">
          <span class="legend__item">
            <span class="swatch swatch--one" aria-hidden="true"></span> bit = 1
          </span>
          <span class="legend__item">
            <span class="swatch swatch--zero" aria-hidden="true"></span> bit = 0
          </span>
          <span class="legend__item">
            <span class="swatch swatch--dilate" aria-hidden="true"></span> DILATE (adjacency)
          </span>
          <span class="legend__item">
            <span class="swatch swatch--marker" aria-hidden="true"></span> MARKER (zero-run)
          </span>
        </div>
      </figure>

      <!-- Live state -->
      <div class="readout" data-readout>
        <div class="readout__cell readout__cell--wide">
          <p class="label">Sketch · 64-bit</p>
          <p class="readout__sketch num" data-sketch>—</p>
          <p class="readout__sub">
            <span data-sketchpop>—</span> bits set ·
            <span data-sketchdelta>—</span> flipped this step
          </p>
        </div>
        <div class="readout__cell">
          <p class="label">r · dilation exponent</p>
          <p class="readout__big num" data-r>0</p>
        </div>
        <div class="readout__cell">
          <p class="label">zeroRun</p>
          <p class="readout__big num" data-zerorun>0</p>
        </div>
        <div class="readout__cell">
          <p class="label">W · 6-bit window</p>
          <p class="readout__big num">
            <span data-w-binary>000000</span>
            <span class="readout__dec" data-w-dec>0</span>
          </p>
        </div>
        <div class="readout__cell">
          <p class="label">Dilations</p>
          <p class="readout__big num" data-dilations>0</p>
        </div>
        <div class="readout__cell">
          <p class="label">Markers</p>
          <p class="readout__big num" data-markers>0</p>
        </div>
      </div>

      <p class="eventline" data-eventline>No event at this position.</p>
    </div>
  </div>

  <div class="notes">
    <section class="note verified-note">
      <p>
        <strong>Measured.</strong> <code>Sketch</code>, <code>r</code>, <code>W</code>,
        <code>zeroRun</code> and both counters are the state after exactly the bit under the
        cursor — the same values <code>fsvm.Step</code> returns in Go.
      </p>
    </section>

    <section class="note claim-note">
      <p>
        <strong>Try this.</strong> Set the width to 1 and press play, then switch to 3 and press
        reset. The dilation ticks thin out but never reorder — because width 1, 2 and 3 test for a
        1-run of length at least 2, 3 and 4, so the event sets are
        <em>nested</em>. The sketch is identical in all three, because the fold does not see width.
        That is the retraction the
        <a href="/demo/width-axis">width demo</a> runs an assertion on.
      </p>
    </section>

    <section class="note retract-note">
      <p>
        <strong>Caveat.</strong> Switching to v2 changes the sketch algorithm, so the two versions
        are not comparable at the same input. v2 folds zero-run length, the dilation exponent and
        per-event salts into the value in addition to the window.
      </p>
    </section>
  </div>
</Demo>

<script>
  import { invoke } from '../../lib/fib';
  import {
    debounce,
    fmtU64,
    need,
    setStatus,
    shouldAnimate,
    Ticker,
  } from '../../lib/ui';
  import type { U64 } from '../../lib/fib';

  /* ---- Wire types, mirroring internal/wasmapi/fsvm.go ------------------- */

  interface FsvmEvent {
    pos: number;
    kind: 'DILATE' | 'MARKER' | 'UNKNOWN';
    payload: U64;
  }

  interface FsvmFinal {
    r: number;
    zeroRun: U64;
    w: number;
    lastBit: number;
    sketch: U64;
    sketchDelta: number;
    dilations: U64;
    markers: U64;
    bitsProcessed: U64;
    sketchPopcount: number;
  }

  interface FsvmRun {
    bitCount: number;
    bits: string;
    r: number[];
    w: number[];
    zeroRun: U64[];
    sketch: U64[];
    sketchDelta: number[];
    events: FsvmEvent[];
    final: FsvmFinal;
    truncated: boolean;
    version: number;
    width: number;
  }

  /* ---- DOM ------------------------------------------------------------- */

  const status = need<HTMLElement>('[data-status]');
  const body = need<HTMLElement>('[data-body]');
  const canvas = need<HTMLCanvasElement>('[data-canvas]');
  const alt = need<HTMLElement>('[data-alt]');
  const textInput = need<HTMLTextAreaElement>('[data-text]');
  const maxBits = need<HTMLInputElement>('[data-maxbits]');
  const speedInput = need<HTMLInputElement>('[data-speed]');
  const scrub = need<HTMLInputElement>('[data-scrub]');
  const playBtn = need<HTMLButtonElement>('[data-play]');
  const eventLine = need<HTMLElement>('[data-eventline]');

  const out = {
    sketch: need<HTMLElement>('[data-sketch]'),
    sketchPop: need<HTMLElement>('[data-sketchpop]'),
    sketchDelta: need<HTMLElement>('[data-sketchdelta]'),
    r: need<HTMLElement>('[data-r]'),
    zeroRun: need<HTMLElement>('[data-zerorun]'),
    wBin: need<HTMLElement>('[data-w-binary]'),
    wDec: need<HTMLElement>('[data-w-dec]'),
    dilations: need<HTMLElement>('[data-dilations]'),
    markers: need<HTMLElement>('[data-markers]'),
  };

  let version = 1;
  let width = 1;
  let run: FsvmRun | null = null;
  let cursor = 0;
  let accumulated = 0;
  let ctx: CanvasRenderingContext2D | null = null;
  let geom = { cell: 0, top: 0, plotH: 0, viewW: 0, visible: 0, start: 0 };

  /* ---- Loading --------------------------------------------------------- */

  async function boot(): Promise<void> {
    try {
      // Warm the module with a tiny call so the big download happens before the
      // user starts interacting, and surface a real error if it fails.
      await invoke('fsvm.meta', {});
      body.hidden = false;
      status.hidden = true;
      await refresh();
    } catch (err) {
      setStatus(status, (err as Error).message, 'error');
    }
  }

  /* ---- Data ------------------------------------------------------------ */

  async function refresh(): Promise<void> {
    try {
      const { data, warnings } = await invoke<FsvmRun>('fsvm.run', {
        text: textInput.value,
        version,
        width,
        maxBits: Number(maxBits.value) || 1024,
      });
      run = data;
      cursor = 0;
      accumulated = 0;
      scrub.max = String(Math.max(data.bitCount - 1, 0));
      scrub.value = '0';

      if (data.truncated) {
        eventLine.textContent =
          'Input longer than the bit limit — truncated for display. The state below is real.';
      } else if (warnings.length) {
        eventLine.textContent = warnings.join(' ');
      } else {
        eventLine.textContent = 'No event at this position.';
      }
      draw();
      paint();
    } catch (err) {
      setStatus(status, (err as Error).message, 'error');
      body.hidden = true;
    }
  }

  const refreshDebounced = debounce(() => void refresh(), 260);

  /* ---- Canvas ---------------------------------------------------------- */

  const css = () =>
    getComputedStyle(document.documentElement);

  function ensureContext(): CanvasRenderingContext2D {
    if (!ctx) {
      const host = canvas.parentElement as HTMLElement;
      ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('canvas 2d context unavailable');
      const w = Math.max(host.clientWidth, 320);
      const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(190 * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = '190px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    return ctx;
  }

  function draw(): void {
    if (!run) return;
    const g = ensureContext();
    const c = css();
    const plotH = 96;
    const top = 14;
    const viewW = canvas.width / (Math.min(window.devicePixelRatio || 1, 2.5));
    const cell = Math.max(2, Math.min(7, Math.floor(viewW / Math.min(run.bitCount, 240))));
    const visible = Math.max(8, Math.floor(viewW / cell));
    const start = Math.max(0, Math.min(cursor - Math.floor(visible / 2), run.bitCount - visible));
    geom = { cell, top, plotH, viewW, visible, start };

    g.clearRect(0, 0, viewW, 190);

    const ink = c.getPropertyValue('--ink').trim();
    const mute = c.getPropertyValue('--ink-mute').trim();
    const rule = c.getPropertyValue('--rule').trim();
    const sunk = c.getPropertyValue('--surface-sunk').trim();
    const brass = c.getPropertyValue('--brass').trim();
    const verify = c.getPropertyValue('--verify').trim();
    const retract = c.getPropertyValue('--retract').trim();

    // Sunk well behind the plot, so the ribbon reads as recessed into the panel.
    g.fillStyle = sunk;
    roundRect(g, 0, top, visible * cell, plotH, 6);
    g.fill();
    g.strokeStyle = rule;
    g.lineWidth = 1;
    roundRect(g, 0.5, top + 0.5, visible * cell - 1, plotH - 1, 6);
    g.stroke();

    const end = Math.min(run.bitCount, start + visible);
    for (let i = start; i < end; i++) {
      const x = (i - start) * cell;
      const isOne = run.bits[i] === '1';
      const past = i < cursor;

      // Bit bar: height encodes the value, and colour encodes whether the bit has
      // been consumed by the stepper yet.
      const h = isOne ? plotH - 10 : 5;
      g.fillStyle = past ? (isOne ? brass : mute) : isOne ? verify : rule;
      g.fillRect(x + 1, top + plotH - 2 - h, Math.max(cell - 2, 1), h);

      // Event ticks above the plot.
      for (const ev of run.events) {
        if (ev.pos !== i) continue;
        g.fillStyle = ev.kind === 'DILATE' ? retract : verify;
        g.fillRect(x + 1, top - 9, Math.max(cell - 2, 1), 7);
      }
    }

    // Cursor: a solid brass line, plus a 1px dark keyline so it stays visible
    // against both the well and the bars.
    if (run.bitCount > 0) {
      const cx = (cursor - start) * cell;
      if (cx >= -cell && cx <= visible * cell) {
        g.fillStyle = ink;
        g.fillRect(cx - 1, top - 12, 2, plotH + 16);
        g.fillStyle = brass;
        g.fillRect(cx - 2, top - 12, 4, plotH + 16);
        g.fillStyle = ink;
        g.fillRect(cx - 1, top - 12, 1, plotH + 16);
      }
    }

    // Axis labels.
    g.fillStyle = mute;
    g.font = '10px ui-monospace, monospace';
    g.fillText(`${start}`, 2, 184);
    const endLabel = `${end - 1}`;
    g.fillText(endLabel, visible * cell - g.measureText(endLabel).width, 184);
    g.fillText(`bit`, visible * cell / 2 - 8, 184);

    // Text alternative for assistive tech: a real description, not a caption.
    alt.textContent =
      `Bit ribbon for ${run.bitCount} bits, cursor at ${cursor}. ` +
      `State: dilation exponent ${run.r[Math.max(cursor - 1, 0)] ?? 0}, ` +
      `zero-run ${run.zeroRun[Math.max(cursor - 1, 0)] ?? '0'}, ` +
      `window ${(run.w[Math.max(cursor - 1, 0)] ?? 0).toString(2).padStart(6, '0')}. ` +
      `${run.events.length} events in total.`;
  }

  function roundRect(
    g: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    r: number,
  ): void {
    g.beginPath();
    g.moveTo(x + r, y);
    g.arcTo(x + w, y, x + w, y + h, r);
    g.arcTo(x + w, y + h, x, y + h, r);
    g.arcTo(x, y + h, x, y, r);
    g.arcTo(x, y, x + w, y, r);
    g.closePath();
  }

  /* ---- Readout --------------------------------------------------------- */

  function paint(): void {
    if (!run) return;
    // The arrays hold state *after* bit i, so the state at the cursor is index
    // cursor - 1. At cursor 0 nothing has been consumed yet.
    const i = Math.max(cursor - 1, 0);
    const consumed = cursor > 0;

    out.r.textContent = consumed ? String(run.r[i]) : '0';
    out.zeroRun.textContent = consumed ? fmtU64(run.zeroRun[i]) : '0';
    out.wBin.textContent = (consumed ? run.w[i] : 0).toString(2).padStart(6, '0');
    out.wDec.textContent = String(consumed ? run.w[i] : 0);
    out.dilations.textContent = consumed ? fmtU64(run.final.dilations) : '0';
    out.markers.textContent = consumed ? fmtU64(run.final.markers) : '0';

    if (consumed) {
      const sk = run.sketch[i];
      out.sketch.textContent = fmtU64(sk);
      out.sketchPop.textContent = String(popcountStr(sk));
      out.sketchDelta.textContent = String(run.sketchDelta[i]);
    } else {
      out.sketch.textContent = '0';
      out.sketchPop.textContent = '0';
      out.sketchDelta.textContent = '0';
    }

    if (!run.truncated) {
      const at = run.events.find((e) => e.pos === cursor);
      if (at) {
        eventLine.textContent =
          at.kind === 'DILATE'
            ? `DILATE at bit ${at.pos} — two adjacent ones, so r advanced to ${run.r[i]}.`
            : `MARKER at bit ${at.pos} — zero-run crossed ${at.payload}, a power of two at or above 8.`;
      } else {
        eventLine.textContent = 'No event at this position.';
      }
    }
  }

  function popcountStr(v: U64): number {
    let n = 0n;
    let x = BigInt(v);
    while (x) {
      x &= x - 1n;
      n += 1n;
    }
    return Number(n);
  }

  /* ---- Playback -------------------------------------------------------- */

  const ticker = new Ticker(() => {
    if (!run) return;
    const speed = Math.max(Number(speedInput.value) || 220, 1);
    accumulated += (speed * 16.6666667) / 1000;
    let advanced = false;
    while (accumulated >= 1 && cursor < run.bitCount) {
      cursor += 1;
      accumulated -= 1;
      advanced = true;
    }
    if (cursor >= run.bitCount) {
      ticker.stop();
      playBtn.textContent = '▶ Play';
      playBtn.setAttribute('aria-pressed', 'false');
    }
    if (advanced) {
      scrub.value = String(cursor);
      draw();
      paint();
    }
  });

  function setPlaying(on: boolean): void {
    playBtn.textContent = on ? '❙❙ Pause' : '▶ Play';
    playBtn.setAttribute('aria-pressed', String(on));
    if (on && run && cursor >= run.bitCount) cursor = 0;
    if (on) ticker.start();
    else ticker.stop();
  }

  /* ---- Events ---------------------------------------------------------- */

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-version]')) {
    btn.addEventListener('click', () => {
      version = Number(btn.dataset.version);
      for (const b of document.querySelectorAll('[data-version]')) {
        b.setAttribute('aria-pressed', String(b === btn));
      }
      setPlaying(false);
      void refresh();
    });
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-width]')) {
    btn.addEventListener('click', () => {
      width = Number(btn.dataset.width);
      for (const b of document.querySelectorAll('[data-width]')) {
        b.setAttribute('aria-pressed', String(b === btn));
      }
      setPlaying(false);
      void refresh();
    });
  }

  textInput.addEventListener('input', () => {
    setPlaying(false);
    refreshDebounced();
  });
  maxBits.addEventListener('change', () => {
    setPlaying(false);
    void refresh();
  });

  playBtn.addEventListener('click', () => setPlaying(!ticker.isRunning));
  need<HTMLButtonElement>('[data-step]').addEventListener('click', () => {
    setPlaying(false);
    if (run && cursor < run.bitCount) cursor += 1;
    scrub.value = String(cursor);
    draw();
    paint();
  });
  need<HTMLButtonElement>('[data-reset]').addEventListener('click', () => {
    setPlaying(false);
    cursor = 0;
    scrub.value = '0';
    draw();
    paint();
  });

  scrub.addEventListener('input', () => {
    setPlaying(false);
    cursor = Number(scrub.value);
    draw();
    paint();
  });

  let resizeRaf = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(() => {
      ctx = null; // force re-measure
      draw();
    });
  });

  // Reduced motion: the play button still works, it just is not the default
  // affordance and nothing animates on load.
  if (shouldAnimate()) {
    // Deliberately do not autoplay. The visitor asked to read; the demo is
    // there when they want it.
  }

  void boot();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .stage {
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .stage__loading {
    color: var(--ink-dim);
    font-size: 0.92rem;
    padding: 2rem 0;
    text-align: center;
  }
  .stage__loading[data-kind='error'] {
    color: var(--retract-lit);
    text-align: left;
    white-space: pre-wrap;
  }

  /* ---- Controls ---- */
  .controls {
    display: grid;
    gap: 1.15rem;
    margin-bottom: 1.5rem;
  }
  .controls__row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
  }
  .controls__row--play {
    padding-top: 0.35rem;
    border-top: var(--rule-w) solid var(--rule);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field--grow {
    flex: 1 1 22rem;
  }
  .field--narrow {
    flex: 0 0 8rem;
  }
  .field__hint {
    font-size: 0.72rem;
    color: var(--ink-mute);
  }

  .seg__group {
    display: flex;
    gap: 0.3rem;
  }
  .seg__group button {
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
  }

  .scrub {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .btn--primary {
    color: var(--brass-lit);
    border-color: var(--brass-dim);
  }

  /* ---- Ribbon ---- */
  .ribbon {
    margin: 0 0 1.25rem;
  }
  .ribbon figcaption {
    margin-bottom: 0.5rem;
  }
  .ribbon__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.25rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: 0.6rem;
    font-size: 0.74rem;
    color: var(--ink-dim);
  }
  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
    border: var(--rule-w) solid var(--rule);
    flex-shrink: 0;
  }
  .swatch--one {
    background: var(--brass);
  }
  .swatch--zero {
    background: var(--rule);
  }
  .swatch--dilate {
    background: var(--retract);
  }
  .swatch--marker {
    background: var(--verify);
  }

  /* ---- Readout ---- */
  .readout {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
  }
  .readout__cell {
    background: var(--surface-sunk);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-sm);
    box-shadow: var(--sunk-sm);
    padding: 0.8rem 0.9rem;
  }
  .readout__cell--wide {
    grid-column: span 2;
    min-width: 0;
  }
  @media (max-width: 40rem) {
    .readout__cell--wide {
      grid-column: span 1;
    }
  }

  .readout__big {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.15;
    margin-top: 0.25rem;
    word-break: break-all;
  }
  .readout__dec {
    font-size: 0.8rem;
    color: var(--ink-mute);
    margin-left: 0.4rem;
  }
  .readout__sketch {
    font-size: 0.95rem;
    font-weight: 600;
    margin-top: 0.35rem;
    word-break: break-all;
    line-height: 1.4;
  }
  .readout__sub {
    font-size: 0.72rem;
    color: var(--ink-mute);
    margin-top: 0.25rem;
  }

  .eventline {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
